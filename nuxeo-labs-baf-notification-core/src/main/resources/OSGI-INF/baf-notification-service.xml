<?xml version="1.0"?>
<component name="nuxeo.labs.baf.notification.service">

  <implementation class="nuxeo.labs.bafnotification.BAFNotificationServiceImpl" />

  <service>
    <provide interface="nuxeo.labs.bafnotification.BAFNotificationService" />
  </service>

  <extension-point name="configuration">
    <object class="nuxeo.labs.bafnotification.BAFNotificationConfigDescriptor" />
  </extension-point>

  <!--
    Example contribution. Without any contribution, the bulkActionDone event is fired
    for every completed/aborted BAF command. As soon as one contribution exists, only
    the listed action names trigger the event. Multiple contributions are merged (union),
    so a Studio project and a custom plugin can each contribute their own list.

    <extension target="nuxeo.labs.baf.notification.service" point="configuration">
      <actions>
        <action>setProperties</action>
        <action>csvExport</action>
      </actions>
    </extension>
  -->

</component>
